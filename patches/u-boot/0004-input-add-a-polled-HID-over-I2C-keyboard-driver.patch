diff --git a/drivers/input/hid_kbd.c b/drivers/input/hid_kbd.c
index bd937eb6307..ec1a05bdccb 100644
--- a/drivers/input/hid_kbd.c
+++ b/drivers/input/hid_kbd.c
@@ -5,10 +5,167 @@
 
 #include <hid_kbd.h>
 #include <input.h>
+#include <linux/errno.h>
 #include <linux/input.h>
 #include <linux/kernel.h>
 #include <linux/string.h>
 
+#define HID_PAGE_GENERIC_DESKTOP	0x01
+#define HID_PAGE_KEYBOARD		0x07
+#define HID_USAGE_KEYBOARD		0x06
+#define HID_COLLECTION_APPLICATION	0x01
+#define HID_MAIN_CONSTANT		BIT(0)
+#define HID_MAIN_VARIABLE		BIT(1)
+#define HID_PUSH_DEPTH			4
+
+struct hid_globals {
+	u16 usage_page;
+	u8 report_id;
+	u32 report_size;
+	u32 report_count;
+};
+
+/* A 4-byte usage carries its page; shorter ones take the page at the main item */
+struct hid_usage {
+	u32 value;
+	bool extended;
+	bool present;
+};
+
+static u32 hid_usage_resolve(const struct hid_usage *u, u16 page)
+{
+	return u->extended ? u->value : (u32)page << 16 | (u->value & 0xffff);
+}
+
+int hid_kbd_parse_layout(const u8 *rdesc, uint len,
+			 struct hid_kbd_layout *layout)
+{
+	struct hid_globals g = { 0 }, stack[HID_PUSH_DEPTH];
+	struct hid_usage usage = { 0 }, umin = { 0 }, umax = { 0 };
+	u16 bits[256] = { 0 };
+	int sp = 0, depth = 0, kbd_depth = 0;
+	bool have_mods = false, have_keys = false;
+	uint i = 0;
+
+	memset(layout, 0, sizeof(*layout));
+	while (i < len) {
+		u8 prefix = rdesc[i];
+		uint size, n;
+		u32 val = 0;
+
+		if (prefix == 0xfe) {	/* long item */
+			if (i + 1 >= len)
+				break;
+			i += 3 + rdesc[i + 1];
+			continue;
+		}
+		size = (prefix & 3) == 3 ? 4 : prefix & 3;
+		if (i + 1 + size > len)
+			break;
+		for (n = 0; n < size; n++)
+			val |= (u32)rdesc[i + 1 + n] << (8 * n);
+		i += 1 + size;
+
+		switch (prefix & 0xfc) {
+		case 0x04:	/* Usage Page */
+			g.usage_page = val;
+			break;
+		case 0x74:	/* Report Size */
+			g.report_size = val;
+			break;
+		case 0x84:	/* Report ID */
+			g.report_id = val;
+			break;
+		case 0x94:	/* Report Count */
+			g.report_count = val;
+			break;
+		case 0xa4:	/* Push */
+			if (sp == HID_PUSH_DEPTH)
+				return -E2BIG;
+			stack[sp++] = g;
+			break;
+		case 0xb4:	/* Pop */
+			if (!sp)
+				return -EINVAL;
+			g = stack[--sp];
+			break;
+		case 0x08:	/* Usage */
+			if (!usage.present)
+				usage = (struct hid_usage){ val, size == 4, true };
+			break;
+		case 0x18:	/* Usage Minimum */
+			umin = (struct hid_usage){ val, size == 4, true };
+			break;
+		case 0x28:	/* Usage Maximum */
+			umax = (struct hid_usage){ val, size == 4, true };
+			break;
+		case 0xa0:	/* Collection */
+			depth++;
+			if (!kbd_depth && val == HID_COLLECTION_APPLICATION &&
+			    usage.present &&
+			    hid_usage_resolve(&usage, g.usage_page) ==
+			    (HID_PAGE_GENERIC_DESKTOP << 16 | HID_USAGE_KEYBOARD))
+				kbd_depth = depth;
+			break;
+		case 0xc0:	/* End Collection */
+			if (depth == kbd_depth)
+				kbd_depth = 0;
+			if (depth)
+				depth--;
+			break;
+		case 0x80: {	/* Input */
+			u32 off = bits[g.report_id];
+			u32 page = umin.present ?
+				   hid_usage_resolve(&umin, g.usage_page) >> 16 :
+				   g.usage_page;
+			bool same_id;
+
+			if (kbd_depth && !(val & HID_MAIN_CONSTANT) &&
+			    page == HID_PAGE_KEYBOARD && !(off % 8)) {
+				same_id = layout->report_id == g.report_id;
+				if (!have_mods && (val & HID_MAIN_VARIABLE) &&
+				    g.report_size == 1 && g.report_count == 8 &&
+				    umin.present && umax.present &&
+				    (umin.value & 0xffff) == 0xe0 &&
+				    (umax.value & 0xffff) == 0xe7 &&
+				    (!have_keys || same_id)) {
+					layout->report_id = g.report_id;
+					layout->mod_offset = off / 8;
+					have_mods = true;
+				} else if (!have_keys &&
+					   !(val & HID_MAIN_VARIABLE) &&
+					   g.report_size == 8 &&
+					   (!have_mods || same_id)) {
+					layout->report_id = g.report_id;
+					layout->keys_offset = off / 8;
+					layout->nkeys = min_t(u32, g.report_count,
+							      HID_KBD_MAX_KEYS);
+					have_keys = true;
+				}
+			}
+			off += g.report_size * g.report_count;
+			if (off > U16_MAX)
+				return -E2BIG;
+			bits[g.report_id] = off;
+			break;
+		}
+		}
+
+		if ((prefix & 0x0c) == 0x00) {	/* main item ends the locals */
+			usage.present = false;
+			umin.present = false;
+			umax.present = false;
+		}
+	}
+
+	if (!have_mods || !have_keys)
+		return -ENOENT;
+	layout->len = max(layout->mod_offset + 1,
+			  layout->keys_offset + layout->nkeys);
+
+	return 0;
+}
+
 /* Keyboard/Keypad usage to key code */
 static const u8 hid_kbd_keymap[] = {
 	KEY_RESERVED, 0xff, 0xff, 0xff,
diff --git a/drivers/input/i2c_hid_kbd.c b/drivers/input/i2c_hid_kbd.c
new file mode 100644
index 00000000000..5352ebc1b79
--- /dev/null
+++ b/drivers/input/i2c_hid_kbd.c
@@ -0,0 +1,426 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Keyboard on a HID-over-I2C device.
+ *
+ * The keyboard report's layout comes from the report descriptor
+ * (hid_kbd_parse_layout()). The device is polled: input is read only while
+ * its interrupt line is asserted, and while it is idle a short descriptor
+ * read every I2C_HID_POLL_MS checks that it is still there. A transfer
+ * error marks the device detached; it is re-initialised as soon as
+ * transfers succeed again, so it can be attached after probe and
+ * re-attached.
+ */
+
+#include <dm.h>
+#include <hid_kbd.h>
+#include <i2c.h>
+#include <keyboard.h>
+#include <log.h>
+#include <malloc.h>
+#include <stdio_dev.h>
+#include <time.h>
+#include <asm/gpio.h>
+#include <asm/unaligned.h>
+#include <dm/device_compat.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <linux/delay.h>
+#include <power/regulator.h>
+
+#define I2C_HID_OPCODE_RESET		0x01
+#define I2C_HID_OPCODE_SET_POWER	0x08
+#define I2C_HID_PWR_ON			0x00
+#define I2C_HID_BCD_VERSION		0x0100
+
+#define I2C_HID_RESET_TIMEOUT_MS	1000
+#define I2C_HID_POLL_MS			100
+
+#define HID_USAGE_ERROR_UNDEFINED	0x03
+
+struct i2c_hid_desc {
+	__le16 wHIDDescLength;
+	__le16 bcdVersion;
+	__le16 wReportDescLength;
+	__le16 wReportDescRegister;
+	__le16 wInputRegister;
+	__le16 wMaxInputLength;
+	__le16 wOutputRegister;
+	__le16 wMaxOutputLength;
+	__le16 wCommandRegister;
+	__le16 wDataRegister;
+	__le16 wVendorID;
+	__le16 wProductID;
+	__le16 wVersionID;
+	__le32 reserved;
+} __packed;
+
+enum i2c_hid_kbd_state {
+	I2C_HID_KBD_DETACHED,
+	I2C_HID_KBD_ATTACHED,
+	/* Attached, but its report descriptor has no supported keyboard */
+	I2C_HID_KBD_UNSUPPORTED,
+};
+
+struct i2c_hid_kbd_priv {
+	struct gpio_desc irq;
+	u16 desc_reg;
+	enum i2c_hid_kbd_state state;
+	ulong last_poll;
+	struct i2c_hid_desc desc;
+	struct hid_kbd_layout layout;
+	u8 *inbuf;
+	u16 inbuf_len;
+	u8 mods;
+	u8 keys[HID_KBD_MAX_KEYS];
+};
+
+static int i2c_hid_xfer(struct udevice *dev, u8 *wbuf, int wlen, u8 *rbuf,
+			int rlen)
+{
+	struct dm_i2c_chip *chip = dev_get_parent_plat(dev);
+	struct i2c_msg msg[2];
+	int n = 0;
+
+	if (wlen) {
+		msg[n].addr = chip->chip_addr;
+		msg[n].flags = 0;
+		msg[n].len = wlen;
+		msg[n].buf = wbuf;
+		n++;
+	}
+	if (rlen) {
+		msg[n].addr = chip->chip_addr;
+		msg[n].flags = I2C_M_RD;
+		msg[n].len = rlen;
+		msg[n].buf = rbuf;
+		n++;
+	}
+
+	return dm_i2c_xfer(dev, msg, n);
+}
+
+static int i2c_hid_read_register(struct udevice *dev, u16 reg, void *buf,
+				 int len)
+{
+	u8 cmd[2] = { reg & 0xff, reg >> 8 };
+
+	return i2c_hid_xfer(dev, cmd, sizeof(cmd), buf, len);
+}
+
+static int i2c_hid_command(struct udevice *dev, u8 opcode, u8 arg)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	u16 reg = le16_to_cpu(priv->desc.wCommandRegister);
+	u8 cmd[4] = { reg & 0xff, reg >> 8, arg, opcode };
+
+	return i2c_hid_xfer(dev, cmd, sizeof(cmd), NULL, 0);
+}
+
+static int i2c_hid_set_power_on(struct udevice *dev)
+{
+	int ret;
+
+	ret = i2c_hid_command(dev, I2C_HID_OPCODE_SET_POWER, I2C_HID_PWR_ON);
+	if (ret) {
+		/* some devices need time to wake from deep sleep */
+		udelay(500);
+		ret = i2c_hid_command(dev, I2C_HID_OPCODE_SET_POWER,
+				      I2C_HID_PWR_ON);
+	}
+
+	return ret;
+}
+
+/* Returns the length field of the input, 0 for a reset response */
+static int i2c_hid_read_input(struct udevice *dev)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = i2c_hid_xfer(dev, NULL, 0, priv->inbuf, priv->inbuf_len);
+	if (ret)
+		return ret;
+
+	return get_unaligned_le16(priv->inbuf);
+}
+
+static int i2c_hid_reset(struct udevice *dev)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	ulong start;
+	int ret;
+
+	ret = i2c_hid_set_power_on(dev);
+	if (ret)
+		return ret;
+	ret = i2c_hid_command(dev, I2C_HID_OPCODE_RESET, 0);
+	if (ret)
+		return ret;
+
+	start = get_timer(0);
+	while (get_timer(start) < I2C_HID_RESET_TIMEOUT_MS) {
+		if (dm_gpio_get_value(&priv->irq) > 0) {
+			ret = i2c_hid_read_input(dev);
+			if (ret < 0)
+				return ret;
+			if (!ret)
+				break;
+		}
+		mdelay(1);
+	}
+
+	return i2c_hid_set_power_on(dev);
+}
+
+static bool i2c_hid_present(struct udevice *dev)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	u8 hdr[4];
+
+	return !i2c_hid_read_register(dev, priv->desc_reg, hdr, sizeof(hdr)) &&
+	       get_unaligned_le16(hdr) == sizeof(struct i2c_hid_desc) &&
+	       get_unaligned_le16(hdr + 2) == I2C_HID_BCD_VERSION;
+}
+
+static void i2c_hid_kbd_update(struct input_config *input, u8 mods,
+			       const u8 *keys)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(input->dev);
+	uint nkeys = priv->layout.nkeys;
+
+	hid_kbd_update(input, priv->mods, priv->keys, mods, keys, nkeys);
+	priv->mods = mods;
+	memcpy(priv->keys, keys, nkeys);
+}
+
+static void i2c_hid_kbd_report(struct input_config *input, int len)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(input->dev);
+	struct hid_kbd_layout *l = &priv->layout;
+	u8 *report = priv->inbuf + 2;
+	uint i;
+
+	if (len < 2 || len > priv->inbuf_len)
+		return;
+	len -= 2;
+	if (l->report_id) {
+		if (!len || report[0] != l->report_id)
+			return;
+		report++;
+		len--;
+	}
+	if (len < l->len)
+		return;
+
+	/* rollover and error states keep the previous keys */
+	for (i = 0; i < l->nkeys; i++)
+		if (report[l->keys_offset + i] &&
+		    report[l->keys_offset + i] <= HID_USAGE_ERROR_UNDEFINED)
+			return;
+
+	i2c_hid_kbd_update(input, report[l->mod_offset],
+			   report + l->keys_offset);
+}
+
+static void i2c_hid_kbd_detach(struct input_config *input)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(input->dev);
+	static const u8 none[HID_KBD_MAX_KEYS];
+
+	i2c_hid_kbd_update(input, 0, none);
+	free(priv->inbuf);
+	priv->inbuf = NULL;
+	priv->state = I2C_HID_KBD_DETACHED;
+}
+
+static int i2c_hid_kbd_attach(struct udevice *dev)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	uint rdesc_len;
+	u8 *rdesc;
+	int ret;
+
+	ret = i2c_hid_read_register(dev, priv->desc_reg, &priv->desc,
+				    sizeof(priv->desc));
+	if (ret)
+		return ret;
+	if (le16_to_cpu(priv->desc.wHIDDescLength) != sizeof(priv->desc) ||
+	    le16_to_cpu(priv->desc.bcdVersion) != I2C_HID_BCD_VERSION)
+		return -EPROTO;
+
+	priv->inbuf_len = max_t(u16, le16_to_cpu(priv->desc.wMaxInputLength), 2);
+	priv->inbuf = malloc(priv->inbuf_len);
+	if (!priv->inbuf)
+		return -ENOMEM;
+
+	ret = i2c_hid_reset(dev);
+	if (ret)
+		goto err;
+
+	rdesc_len = le16_to_cpu(priv->desc.wReportDescLength);
+	rdesc = malloc(rdesc_len);
+	if (!rdesc) {
+		ret = -ENOMEM;
+		goto err;
+	}
+	ret = i2c_hid_read_register(dev,
+				    le16_to_cpu(priv->desc.wReportDescRegister),
+				    rdesc, rdesc_len);
+	if (!ret) {
+		if (hid_kbd_parse_layout(rdesc, rdesc_len, &priv->layout) ||
+		    2 + !!priv->layout.report_id + priv->layout.len >
+		    priv->inbuf_len)
+			ret = -EPROTONOSUPPORT;
+	}
+	free(rdesc);
+	if (ret)
+		goto err;
+
+	priv->mods = 0;
+	memset(priv->keys, 0, sizeof(priv->keys));
+
+	return 0;
+
+err:
+	free(priv->inbuf);
+	priv->inbuf = NULL;
+
+	return ret;
+}
+
+static int i2c_hid_kbd_read_keys(struct input_config *input)
+{
+	struct udevice *dev = input->dev;
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (priv->state == I2C_HID_KBD_ATTACHED &&
+	    dm_gpio_get_value(&priv->irq) > 0) {
+		priv->last_poll = get_timer(0);
+		ret = i2c_hid_read_input(dev);
+		if (ret < 0) {
+			i2c_hid_kbd_detach(input);
+			return 0;
+		}
+		i2c_hid_kbd_report(input, ret);
+		return 1;
+	}
+
+	if (get_timer(priv->last_poll) < I2C_HID_POLL_MS)
+		return 0;
+	priv->last_poll = get_timer(0);
+
+	if (priv->state != I2C_HID_KBD_DETACHED) {
+		if (!i2c_hid_present(dev))
+			i2c_hid_kbd_detach(input);
+		return 0;
+	}
+
+	ret = i2c_hid_kbd_attach(dev);
+	if (!ret) {
+		priv->state = I2C_HID_KBD_ATTACHED;
+	} else if (ret == -EPROTONOSUPPORT) {
+		dev_warn(dev, "no supported keyboard in the report descriptor\n");
+		priv->state = I2C_HID_KBD_UNSUPPORTED;
+	}
+
+	return 0;
+}
+
+/* The interrupt parent must be the GPIO controller, with GPIO-numbered cells */
+static int i2c_hid_kbd_get_irq(struct udevice *dev, struct gpio_desc *desc)
+{
+	struct gpio_dt_spec spec = {
+		.list_name = "interrupts",
+		.flags = GPIOD_IS_IN,
+		.present = true,
+	};
+	u32 irq[2];
+	int ret;
+
+	spec.args.node = ofnode_parse_phandle(dev_ofnode(dev),
+					      "interrupt-parent", 0);
+	if (!ofnode_valid(spec.args.node) ||
+	    !ofnode_read_bool(spec.args.node, "gpio-controller") ||
+	    ofnode_read_u32_default(spec.args.node, "#interrupt-cells", 0) != 2)
+		return -EINVAL;
+
+	ret = dev_read_u32_array(dev, "interrupts", irq, ARRAY_SIZE(irq));
+	if (ret)
+		return ret;
+	spec.args.args_count = 2;
+	spec.args.args[0] = irq[0];
+	spec.args.args[1] = irq[1] & (IRQ_TYPE_EDGE_FALLING | IRQ_TYPE_LEVEL_LOW) ?
+			    GPIO_ACTIVE_LOW : GPIO_ACTIVE_HIGH;
+
+	return gpio_request_parsed(dev, &spec, desc);
+}
+
+static int i2c_hid_kbd_probe(struct udevice *dev)
+{
+	static const char *const supplies[] = { "vdd-supply", "vddl-supply" };
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+	struct keyboard_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct stdio_dev *sdev = &uc_priv->sdev;
+	struct input_config *input = &uc_priv->input;
+	struct udevice *supply;
+	uint i;
+	u32 reg;
+	int ret;
+
+	ret = dev_read_u32(dev, "hid-descr-addr", &reg);
+	if (ret)
+		return log_msg_ret("descr", ret);
+	priv->desc_reg = reg;
+
+	for (i = 0; i < ARRAY_SIZE(supplies); i++) {
+		ret = device_get_supply_regulator(dev, supplies[i], &supply);
+		if (!ret)
+			ret = regulator_set_enable_if_allowed(supply, true);
+		if (ret && ret != -ENOENT && ret != -ENOSYS)
+			return log_msg_ret("supply", ret);
+	}
+	mdelay(dev_read_u32_default(dev, "post-power-on-delay-ms", 0));
+
+	ret = i2c_hid_kbd_get_irq(dev, &priv->irq);
+	if (ret)
+		return log_msg_ret("irq", ret);
+
+	priv->state = I2C_HID_KBD_DETACHED;
+	priv->last_poll = get_timer(0) - I2C_HID_POLL_MS;
+
+	input->dev = dev;
+	input->read_keys = i2c_hid_kbd_read_keys;
+	input_add_tables(input, false);
+	strlcpy(sdev->name, "i2c-hid-kbd", sizeof(sdev->name));
+
+	return input_stdio_register(sdev);
+}
+
+static int i2c_hid_kbd_remove(struct udevice *dev)
+{
+	struct i2c_hid_kbd_priv *priv = dev_get_priv(dev);
+
+	free(priv->inbuf);
+	priv->inbuf = NULL;
+
+	return 0;
+}
+
+static const struct keyboard_ops i2c_hid_kbd_ops = {
+};
+
+static const struct udevice_id i2c_hid_kbd_ids[] = {
+	{ .compatible = "hid-over-i2c" },
+	{ }
+};
+
+U_BOOT_DRIVER(i2c_hid_kbd) = {
+	.name		= "i2c_hid_kbd",
+	.id		= UCLASS_KEYBOARD,
+	.of_match	= i2c_hid_kbd_ids,
+	.probe		= i2c_hid_kbd_probe,
+	.remove		= i2c_hid_kbd_remove,
+	.priv_auto	= sizeof(struct i2c_hid_kbd_priv),
+	.ops		= &i2c_hid_kbd_ops,
+};
