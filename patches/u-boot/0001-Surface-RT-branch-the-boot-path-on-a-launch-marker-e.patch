From 7ad85ef2077f243fa340be651d62e92f693787b7 Mon Sep 17 00:00:00 2001
From: Curd Becker <me@curd-becker.de>
Date: Tue, 27 Oct 2026 16:30:23 +0000
Subject: [PATCH 1/5] Surface RT: branch the boot path on a launch marker (eMMC
 cold boot vs APX RAM preload).

The design-C loader stub of surface-rt-re writes LAUNCH_MAGIC to
LAUNCH_MARKER (PMC_SCRATCH43) when it boots U-Boot from the eMMC.
Without the marker, U-Boot was RAM-loaded over APX (fusee gelee), and
nvidia_board_late_init() sets bootcmd=fastboot usb 0 in the running
environment so the host can take over (the one-shot installer).
Otherwise the normal bootcmd runs: the first bootflow found, else the
boot menu.

The decision is made in board code rather than in bootcmd, so a stored
environment (an older one, or one saved with saveenv) cannot override
it, and the marker is cleared after reading, so a later warm reset into
APX does not inherit it. The board file includes payloads/uboot_stub.h
from the surface-rt-re repository, which carries this tree as a
submodule.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board/microsoft/surface-rt/Makefile     |  6 ++++++
 board/microsoft/surface-rt/surface-rt.c | 25 +++++++++++++++++++++++++
 configs/surface-rt_defconfig            |  1 +
 3 files changed, 32 insertions(+)
 create mode 100644 board/microsoft/surface-rt/surface-rt.c

diff --git a/board/microsoft/surface-rt/Makefile b/board/microsoft/surface-rt/Makefile
index feda1dba3bd..317d26f579a 100644
--- a/board/microsoft/surface-rt/Makefile
+++ b/board/microsoft/surface-rt/Makefile
@@ -4,3 +4,9 @@
 #  Open Surface RT
 
 obj-$(CONFIG_XPL_BUILD) += surface-rt-spl.o
+
+ifndef CONFIG_XPL_BUILD
+obj-y += surface-rt.o
+# uboot_stub.h (the launch marker) is in the surface-rt-re repository, which carries this tree as a submodule
+CFLAGS_surface-rt.o := -I$(srctree)/../payloads -I$(srctree)/..
+endif
diff --git a/board/microsoft/surface-rt/surface-rt.c b/board/microsoft/surface-rt/surface-rt.c
new file mode 100644
index 00000000000..0d432e84d99
--- /dev/null
+++ b/board/microsoft/surface-rt/surface-rt.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Microsoft Surface RT: choose the boot path by how U-Boot was started. The surface-rt-re design-C loader stub
+ * writes LAUNCH_MAGIC to LAUNCH_MARKER when it boots U-Boot from the eMMC. Without it, U-Boot was RAM-loaded
+ * over APX (USB recovery) and enters fastboot so the host can take over. Deciding here rather than in bootcmd
+ * keeps a stored environment from overriding it.
+ */
+
+#include <env.h>
+#include <stdio.h>
+#include <asm/io.h>
+#include <asm/arch-tegra/sys_proto.h>
+#include "uboot_stub.h"
+
+void nvidia_board_late_init(void)
+{
+	int from_emmc = readl(LAUNCH_MARKER) == LAUNCH_MAGIC;
+
+	/* one boot only: a later warm reset into APX must not see it */
+	writel(0, LAUNCH_MARKER);
+	if (!from_emmc) {
+		printf("Started over APX: fastboot\n");
+		env_set("bootcmd", "fastboot usb 0");
+	}
+}
diff --git a/configs/surface-rt_defconfig b/configs/surface-rt_defconfig
index 2eafcd817ab..afc11ee52ff 100644
--- a/configs/surface-rt_defconfig
+++ b/configs/surface-rt_defconfig
@@ -15,6 +15,7 @@ CONFIG_TEGRA30=y
 CONFIG_TARGET_SURFACE_RT=y
 CONFIG_BUTTON_CMD=y
 CONFIG_BOOTDELAY=0
+CONFIG_BOOTCOMMAND="bootflow scan; bootmenu"
 CONFIG_AUTOBOOT_KEYED=y
 CONFIG_AUTOBOOT_KEYED_CTRLC=y
 CONFIG_OF_SYSTEM_SETUP=y
-- 
