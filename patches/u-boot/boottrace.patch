diff --git a/common/console.c b/common/console.c
index 54d1249422d..54709e2e648 100644
--- a/common/console.c
+++ b/common/console.c
@@ -7,6 +7,7 @@
 #define LOG_CATEGORY	LOGC_CONSOLE
 
