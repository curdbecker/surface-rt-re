Boot-trace instrumentation for U-Boot (test/diagnostic, not for a shipping build).

With it, a U-Boot that boots without a usable console records how far it got: numbered checkpoints along
board_init_f / board_init_r (and inside console_init_r), a [probe <dev>]/[/<dev>] and [start <dev>]/[started]
marker around each driver-model probe and console-device start, and a copy of the console. The trace stub
(payloads/uboot_stub-boottrace.bin) sets the storage up before handing over; the device reads it back in disk
mode with diskmode/srt-boottrace. The storage layout is payloads/boottrace.h.

The in-tree header (arch/arm/include/asm/arch-tegra/boottrace.h) only emits code when BOOTTRACE_PROGRESS is
defined; that, and the other addresses, come from payloads/boottrace.h force-included at build time, so the
whole thing compiles to nothing unless the build asks for it. The build, the trace run and the checkpoint map:
README.md, Debugging U-Boot without a console.

diff --git a/arch/arm/include/asm/arch-tegra/boottrace.h b/arch/arm/include/asm/arch-tegra/boottrace.h
new file mode 100644
index 00000000000..c737e2ebe81
--- /dev/null
+++ b/arch/arm/include/asm/arch-tegra/boottrace.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Boot trace (test instrumentation): built with KCFLAGS="-include <surface-rt-re>/boottrace.h", boottrace(n) records
+ * checkpoint n in a PMC scratch register and the console is copied into a log in DRAM, both read back after the
+ * run. Without that header, everything here compiles to nothing.
+ */
+#ifndef _TEGRA_BOOTTRACE_H
+#define _TEGRA_BOOTTRACE_H
+
+#ifdef BOOTTRACE_PROGRESS
+#include <cpu_func.h>
+#include <asm/io.h>
+
+#define boottrace(n)	writel(BOOTTRACE_MAGIC + (n), BOOTTRACE_PROGRESS)
+
+/* Appends to the log the trace stub started; each line written goes out to DRAM before the watchdog reset */
+static inline void boottrace_putc(char c)
+{
+	u32 *log = (u32 *)BOOTTRACE_LOG;
+	ulong at, line;
+
+	if (log[0] != BOOTTRACE_LOG_MAGIC || log[1] >= BOOTTRACE_LOG_SIZE - 8)
+		return;
+	at = BOOTTRACE_LOG + 8 + log[1];
+	*(char *)at = c;
+	log[1]++;
+	line = at & ~(ulong)(CONFIG_SYS_CACHELINE_SIZE - 1);
+	flush_dcache_range(line, line + CONFIG_SYS_CACHELINE_SIZE);
+	flush_dcache_range(BOOTTRACE_LOG, BOOTTRACE_LOG + CONFIG_SYS_CACHELINE_SIZE);
+}
+
+static inline void boottrace_puts(const char *s)
+{
+	while (*s)
+		boottrace_putc(*s++);
+}
+#else
+#define boottrace(n)		do { } while (0)
+#define boottrace_putc(c)	do { } while (0)
+#define boottrace_puts(s)	do { } while (0)
+#endif
+
+#endif /* _TEGRA_BOOTTRACE_H */
