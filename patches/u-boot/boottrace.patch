 #include <debug_uart.h>
 #include <display_options.h>
 #include <dm.h>
@@ -481,7 +482,11 @@ int console_start(int file, struct stdio_dev *sdev)
 
 	/* Start new device */
 	if (sdev->start) {
+		boottrace_puts("[start ");
+		boottrace_puts(sdev->name);
+		boottrace_puts("]");
 		error = sdev->start(sdev);
+		boottrace_puts("[started]");
 		/* If it's not started don't use it */
 		if (error < 0)
 			return error;
@@ -723,6 +728,7 @@ void putc(const char c)
 		return;
 
 	console_record_putc(c);
+	boottrace_putc(c);
 
 	/* sandbox can send characters to stdout before it has a console */
 	if (IS_ENABLED(CONFIG_SANDBOX) && !(gd->flags & GD_FLG_SERIAL_READY)) {
@@ -764,6 +770,7 @@ void puts(const char *s)
 		return;
 
 	console_record_puts(s);
+	boottrace_puts(s);
 
 	/* sandbox can send characters to stdout before it has a console */
 	if (IS_ENABLED(CONFIG_SANDBOX) && !(gd->flags & GD_FLG_SERIAL_READY)) {
@@ -1138,9 +1145,13 @@ int console_init_r(void)
 		outputdev = console_search_dev(DEV_FLAGS_OUTPUT, stdoutname);
 		errdev    = console_search_dev(DEV_FLAGS_OUTPUT, stderrname);
 		if (CONFIG_IS_ENABLED(CONSOLE_MUX)) {
+			boottrace(16);
 			iomux_err = iomux_doenv(stdin, stdinname);
+			boottrace(17);
 			iomux_err += iomux_doenv(stdout, stdoutname);
+			boottrace(18);
 			iomux_err += iomux_doenv(stderr, stderrname);
+			boottrace(19);
 			if (!iomux_err)
 				/* Successful, so skip all the code below. */
 				goto done;
