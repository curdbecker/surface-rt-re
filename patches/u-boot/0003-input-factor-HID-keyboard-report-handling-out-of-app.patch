diff --git a/drivers/input/hid_kbd.c b/drivers/input/hid_kbd.c
new file mode 100644
index 00000000000..bd937eb6307
--- /dev/null
+++ b/drivers/input/hid_kbd.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Key events from HID keyboard reports
+ */
+
+#include <hid_kbd.h>
+#include <input.h>
+#include <linux/input.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+/* Keyboard/Keypad usage to key code */
+static const u8 hid_kbd_keymap[] = {
+	KEY_RESERVED, 0xff, 0xff, 0xff,
+	KEY_A, KEY_B, KEY_C, KEY_D,
+	KEY_E, KEY_F, KEY_G, KEY_H,
+	KEY_I, KEY_J, KEY_K, KEY_L,
+	KEY_M, KEY_N, KEY_O, KEY_P,
+	KEY_Q, KEY_R, KEY_S, KEY_T,
+	KEY_U, KEY_V, KEY_W, KEY_X,
+	KEY_Y, KEY_Z, KEY_1, KEY_2,
+	KEY_3, KEY_4, KEY_5, KEY_6,
+	KEY_7, KEY_8, KEY_9, KEY_0,
+	KEY_ENTER, KEY_ESC, KEY_BACKSPACE, KEY_TAB,
+	KEY_SPACE, KEY_MINUS, KEY_EQUAL, KEY_LEFTBRACE,
+	KEY_RIGHTBRACE, KEY_BACKSLASH, 0xff, KEY_SEMICOLON,
+	KEY_APOSTROPHE, KEY_GRAVE, KEY_COMMA, KEY_DOT,
+	KEY_SLASH, KEY_CAPSLOCK, KEY_F1, KEY_F2,
+	KEY_F3, KEY_F4, KEY_F5, KEY_F6,
+	KEY_F7, KEY_F8, KEY_F9, KEY_F10,
+	KEY_F11, KEY_F12, KEY_SYSRQ, KEY_SCROLLLOCK,
+	KEY_PAUSE, KEY_INSERT, KEY_HOME, KEY_PAGEUP,
+	KEY_DELETE, KEY_END, KEY_PAGEDOWN, KEY_RIGHT,
+	KEY_LEFT, KEY_DOWN, KEY_UP, KEY_NUMLOCK,
+	KEY_KPSLASH, KEY_KPASTERISK, KEY_KPMINUS, KEY_KPPLUS,
+	KEY_KPENTER, KEY_KP1, KEY_KP2, KEY_KP3,
+	KEY_KP4, KEY_KP5, KEY_KP6, KEY_KP7,
+	KEY_KP8, KEY_KP9, KEY_KP0, KEY_KPDOT,
+	KEY_BACKSLASH, KEY_COMPOSE, KEY_POWER, KEY_KPEQUAL,
+};
+
+/* Modifier bits (usages E0-E7) in the order their changes are reported */
+static const struct {
+	u8 bit;
+	u8 key;
+} hid_kbd_modmap[] = {
+	{ BIT(0), KEY_LEFTCTRL },
+	{ BIT(4), KEY_RIGHTCTRL },
+	{ BIT(1), KEY_LEFTSHIFT },
+	{ BIT(5), KEY_RIGHTSHIFT },
+	{ BIT(2), KEY_LEFTALT },
+	{ BIT(6), KEY_RIGHTALT },
+	{ BIT(3), KEY_LEFTMETA },
+	{ BIT(7), KEY_RIGHTMETA },
+};
+
+/* Report @keys[@i] as released or pressed if @others does not hold it */
+static void hid_kbd_key(struct input_config *input, const u8 *keys,
+			const u8 *others, uint i, uint nkeys, bool release)
+{
+	if (memscan((void *)others, keys[i], nkeys) == others + nkeys &&
+	    keys[i] < ARRAY_SIZE(hid_kbd_keymap))
+		input_add_keycode(input, hid_kbd_keymap[keys[i]], release);
+}
+
+void hid_kbd_update(struct input_config *input, u8 old_mods,
+		    const u8 *old_keys, u8 mods, const u8 *keys, uint nkeys)
+{
+	uint i;
+
+	for (i = 0; i < ARRAY_SIZE(hid_kbd_modmap); i++)
+		if ((mods ^ old_mods) & hid_kbd_modmap[i].bit)
+			input_add_keycode(input, hid_kbd_modmap[i].key,
+					  old_mods & hid_kbd_modmap[i].bit);
+	for (i = 0; i < nkeys; i++) {
+		hid_kbd_key(input, old_keys, keys, i, nkeys, true);
+		hid_kbd_key(input, keys, old_keys, i, nkeys, false);
+	}
+}
diff --git a/include/hid_kbd.h b/include/hid_kbd.h
new file mode 100644
index 00000000000..1e8733de868
--- /dev/null
+++ b/include/hid_kbd.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Key events from HID keyboard reports
+ */
+
+#ifndef __HID_KBD_H
+#define __HID_KBD_H
+
+#include <linux/types.h>
+
+struct input_config;
+
+/**
+ * hid_kbd_update() - report a change of HID keyboard state as key events
+ *
+ * The state is that of a boot keyboard report: the modifier bits (usages
+ * E0-E7) and an array of usages from the Keyboard/Keypad page. Modifier
+ * changes are reported first, then for each array slot its released key
+ * before its pressed one.
+ *
+ * @input:	input configuration to report to
+ * @old_mods:	previous modifier bits
+ * @old_keys:	previous key usages, @nkeys entries
+ * @mods:	current modifier bits
+ * @keys:	current key usages, @nkeys entries
+ * @nkeys:	number of entries in @old_keys and @keys
+ */
+void hid_kbd_update(struct input_config *input, u8 old_mods,
+		    const u8 *old_keys, u8 mods, const u8 *keys, uint nkeys);
+
+#endif
