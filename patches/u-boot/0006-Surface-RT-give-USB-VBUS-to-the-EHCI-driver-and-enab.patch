From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Curd Becker <me@curd-becker.de>
Date: Wed, 28 Oct 2026 12:00:00 +0000
Subject: [PATCH] Surface RT: give USB VBUS to the EHCI driver and enable USB
 storage and USB network adatpers

The device tree hogged the VBUS enable (GPIO DD6) low. The hog claims the
pin, so the EHCI driver's request for its nvidia,vbus-gpio failed and
VBUS stayed off in host mode: the controller came up, but no device on
the port was powered.

Remove the hog and drive DD6 low in gpio_early_init() instead, through
gpio_config_table(), which sets the pin up without claiming it. VBUS is
off from the earliest board hook as before, and the EHCI driver switches
it: on in host mode unless VBUS is already present from a remote host,
off in device mode (fastboot, ums).

Enable USB_STORAGE, without which a USB stick never becomes a block
device for usb storage or bootflow scan. And enable support for USB
network adapters while we're at it, since networking setup is
compiled in anyways.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/dts/tegra30-microsoft-surface-rt.dts |  9 ---------
 board/microsoft/surface-rt/surface-rt.c       | 24 ++++++++++++++++++++----
 configs/surface-rt_defconfig                  |  1 +
 3 files changed, 21 insertions(+), 13 deletions(-)

diff --git a/arch/arm/dts/tegra30-microsoft-surface-rt.dts b/arch/arm/dts/tegra30-microsoft-surface-rt.dts
index ac652cc8f00..1aa8bcdac6e 100644
--- a/arch/arm/dts/tegra30-microsoft-surface-rt.dts
+++ b/arch/arm/dts/tegra30-microsoft-surface-rt.dts
@@ -41,15 +41,6 @@
 		};
 	};
 
-	gpio@6000d000 {
-		/* in case usb vbus is on for some reason */
-		usb-vbus-hog {
-			gpio-hog;
-			gpios = <TEGRA_GPIO(DD, 6) GPIO_ACTIVE_HIGH>;
-			output-low;
-		};
-	};
-
 	pinmux@70000868 {
 		pinctrl-names = "default";
 		pinctrl-0 = <&state_default>;
diff --git a/board/microsoft/surface-rt/surface-rt.c b/board/microsoft/surface-rt/surface-rt.c
index 0d432e84d99..bc42f8d55a9 100644
--- a/board/microsoft/surface-rt/surface-rt.c
+++ b/board/microsoft/surface-rt/surface-rt.c
@@ -1,17 +1,33 @@
 // SPDX-License-Identifier: GPL-2.0+
 /*
- * Microsoft Surface RT: choose the boot path by how U-Boot was started. The surface-rt-re design-C loader stub
- * writes LAUNCH_MAGIC to LAUNCH_MARKER when it boots U-Boot from the eMMC. Without it, U-Boot was RAM-loaded
- * over APX (USB recovery) and enters fastboot so the host can take over. Deciding here rather than in bootcmd
- * keeps a stored environment from overriding it.
+ * Microsoft Surface RT board code.
+ *
+ * USB VBUS (GPIO DD6) is driven off at the earliest board hook, without claiming the pin, so that the EHCI
+ * driver can take it as its nvidia,vbus-gpio.
+ *
+ * Boot path: the surface-rt-re design-C loader stub writes LAUNCH_MAGIC to LAUNCH_MARKER when it boots U-Boot
+ * from the eMMC. Without it, U-Boot was RAM-loaded over APX (USB recovery) and enters fastboot so the host can
+ * take over. Deciding here rather than in bootcmd keeps a stored environment from overriding it.
  */
 
 #include <env.h>
 #include <stdio.h>
 #include <asm/io.h>
+#include <asm/arch/gpio.h>
+#include <asm/arch-tegra/board.h>
 #include <asm/arch-tegra/sys_proto.h>
+#include <linux/kernel.h>
 #include "uboot_stub.h"
 
+static const struct tegra_gpio_config surface_rt_gpio_inits[] = {
+	{ .gpio = TEGRA_GPIO(DD, 6), .init = TEGRA_GPIO_INIT_OUT0 },	/* USB VBUS enable */
+};
+
+void gpio_early_init(void)
+{
+	gpio_config_table(surface_rt_gpio_inits, ARRAY_SIZE(surface_rt_gpio_inits));
+}
+
 void nvidia_board_late_init(void)
 {
 	int from_emmc = readl(LAUNCH_MARKER) == LAUNCH_MAGIC;
diff --git a/configs/surface-rt_defconfig b/configs/surface-rt_defconfig
index 0609be7ebee..faa609adf92 100644
--- a/configs/surface-rt_defconfig
+++ b/configs/surface-rt_defconfig
@@ -70,8 +73,15 @@ CONFIG_SYSRESET_TPS65910=y
 CONFIG_USB=y
 CONFIG_USB_EHCI_HCD=y
 CONFIG_USB_EHCI_TEGRA=y
+CONFIG_USB_STORAGE=y
 CONFIG_USB_KEYBOARD=y
 CONFIG_USB_GADGET=y
+CONFIG_USB_HOST_ETHER=y
+CONFIG_USB_ETHER_ASIX=y
+CONFIG_USB_ETHER_ASIX88179=y
+CONFIG_USB_ETHER_MCS7830=y
+CONFIG_USB_ETHER_RTL8152=y
+CONFIG_USB_ETHER_SMSC95XX=y
 CONFIG_CI_UDC=y
 CONFIG_VIDEO=y
 # CONFIG_VIDEO_LOGO is not set
-- 
