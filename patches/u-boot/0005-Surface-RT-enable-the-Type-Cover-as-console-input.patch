From 2ba26d5988c1605865be17f864b1dc8580378fd5 Mon Sep 17 00:00:00 2001
From: Curd Becker <me@curd-becker.de>
Date: Tue, 27 Oct 2026 16:38:49 +0000
Subject: [PATCH 5/5] Surface RT: enable the Type Cover as console input

The Type Cover is a HID-over-I2C device at address 0x00 on I2C1, behind a
detect GPIO (S0) and with its interrupt on GPIO O5, powered from LDO3
(vdd_cover, 2.8 V) and LDO1 (vddio_sensor, 1.8 V). The nodes are those
of the Linux device tree: I2C1, the i2c-hotplug-gpio bus with the cover,
and the two LDOs, which U-Boot sets and enables at probe since they are
marked boot-on.

Tegra boards get the HID-over-I2C keyboard in stdin when the driver is
enabled, as with the USB and button keyboards.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/dts/tegra30-microsoft-surface-rt.dts | 45 +++++++++++++++++++
 configs/surface-rt_defconfig                  |  2 +
 include/configs/tegra-common-post.h           |  8 +++-
 3 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/arch/arm/dts/tegra30-microsoft-surface-rt.dts b/arch/arm/dts/tegra30-microsoft-surface-rt.dts
index 77cd79cb0d6..ac652cc8f00 100644
--- a/arch/arm/dts/tegra30-microsoft-surface-rt.dts
+++ b/arch/arm/dts/tegra30-microsoft-surface-rt.dts
@@ -897,6 +897,37 @@
 		status = "okay";
 	};
 
+	lcd_ddc: i2c@7000c000 {
+		status = "okay";
+		clock-frequency = <400000>;
+	};
+
+	i2c-cover {
+		compatible = "i2c-hotplug-gpio";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&gpio>;
+		interrupts = <TEGRA_GPIO(S, 0) IRQ_TYPE_EDGE_BOTH>;
+		detect-gpios = <&gpio TEGRA_GPIO(S, 0) GPIO_ACTIVE_HIGH>;
+
+		i2c-parent = <&lcd_ddc>;
+
+		cover@0 {
+			compatible = "hid-over-i2c";
+			reg = <0x00>;
+
+			hid-descr-addr = <0x0041>;
+
+			interrupt-parent = <&gpio>;
+			interrupts = <TEGRA_GPIO(O, 5) IRQ_TYPE_LEVEL_LOW>;
+
+			vdd-supply = <&vdd_2v8_cover>;
+			vddl-supply = <&vddio_1v8_sen>;
+		};
+	};
+
 	pwr_i2c: i2c@7000d000 {
 		status = "okay";
 		clock-frequency = <400000>;
@@ -924,6 +955,20 @@
 					regulator-boot-on;
 				};
 
+				vddio_1v8_sen: ldo1 {
+					regulator-name = "vddio_sensor";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-boot-on;
+				};
+
+				vdd_2v8_cover: ldo3 {
+					regulator-name = "vdd_cover";
+					regulator-min-microvolt = <2800000>;
+					regulator-max-microvolt = <2800000>;
+					regulator-boot-on;
+				};
+
 				vddio_usd: ldo5 {
 					regulator-name = "vddio_usd";
 					regulator-min-microvolt = <3300000>;
diff --git a/configs/surface-rt_defconfig b/configs/surface-rt_defconfig
index afc11ee52ff..0609be7ebee 100644
--- a/configs/surface-rt_defconfig
+++ b/configs/surface-rt_defconfig
@@ -56,7 +56,9 @@ CONFIG_FASTBOOT_FLASH=y
 CONFIG_FASTBOOT_FLASH_MMC_DEV=0
 CONFIG_FASTBOOT_CMD_OEM_FORMAT=y
 CONFIG_GPIO_HOG=y
+CONFIG_I2C_HOTPLUG_GPIO=y
 CONFIG_SYS_I2C_TEGRA=y
+CONFIG_I2C_HID_KEYBOARD=y
 CONFIG_BUTTON_KEYBOARD=y
 CONFIG_SPI_FLASH_WINBOND=y
 CONFIG_DM_PMIC=y
diff --git a/include/configs/tegra-common-post.h b/include/configs/tegra-common-post.h
index a9c0cea4e14..a55328cb49a 100644
--- a/include/configs/tegra-common-post.h
+++ b/include/configs/tegra-common-post.h
@@ -21,6 +21,12 @@
 #define STDIN_KBD_USB ""
 #endif
 
+#ifdef CONFIG_I2C_HID_KEYBOARD
+#define STDIN_KBD_I2C_HID ",i2c-hid-kbd"
+#else
+#define STDIN_KBD_I2C_HID ""
+#endif
+
 #ifdef CONFIG_BUTTON_KEYBOARD
 #define STDIN_BTN_KBD ",button-kbd"
 #else
@@ -40,7 +46,7 @@
 #endif
 
 #define TEGRA_DEVICE_SETTINGS \
-	"stdin=serial" STDIN_KBD_KBC STDIN_KBD_USB STDOUT_CROS_EC STDIN_BTN_KBD "\0" \
+	"stdin=serial" STDIN_KBD_KBC STDIN_KBD_USB STDIN_KBD_I2C_HID STDOUT_CROS_EC STDIN_BTN_KBD "\0" \
 	"stdout=serial" STDOUT_VIDEO "\0" \
 	"stderr=serial" STDOUT_VIDEO "\0" \
 	""
